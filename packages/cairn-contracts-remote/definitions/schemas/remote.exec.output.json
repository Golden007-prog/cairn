{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract://remote.exec.output/1.0.0",
  "description": "Result of a remote command execution.",
  "properties": {
    "status": {"default": "succeeded", "title": "Status", "type": "string", "enum": ["running", "succeeded", "failed"]},
    "exit_code": {"default": 0, "title": "Exit Code", "type": "integer"},
    "host": {"default": "", "title": "Host", "type": "string"},
    "workdir": {"default": "", "title": "Workdir", "type": "string"},
    "fetched": {
      "description": "Local paths of fetched outputs.",
      "items": {"type": "string"},
      "title": "Fetched",
      "type": "array"
    },
    "metrics": {
      "additionalProperties": true,
      "description": "Parsed workdir/metrics.json, if the command wrote one.",
      "title": "Metrics",
      "type": "object"
    },
    "error": {"default": "", "title": "Error", "type": "string"}
  },
  "title": "RemoteExecOutput",
  "type": "object"
}
