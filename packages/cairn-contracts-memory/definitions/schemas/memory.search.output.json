{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract://memory.search.output/1.0.0",
  "$defs": {
    "SearchHit": {
      "description": "One returned record + score.",
      "properties": {
        "score": {"title": "Score", "type": "number"},
        "payload": {"additionalProperties": true, "title": "Payload", "type": "object"}
      },
      "required": ["score"],
      "title": "SearchHit",
      "type": "object"
    }
  },
  "description": "Result of a memory search.",
  "properties": {
    "ok": {"title": "Ok", "type": "boolean"},
    "hits": {"items": {"$ref": "#/$defs/SearchHit"}, "title": "Hits", "type": "array"},
    "error": {"default": "", "title": "Error", "type": "string"}
  },
  "required": ["ok"],
  "title": "SearchOutput",
  "type": "object"
}
