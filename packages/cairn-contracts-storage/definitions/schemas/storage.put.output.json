{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract://storage.put.output/1.0.0",
  "description": "Result of an artifact write.\n\n``size_bytes`` (not ``bytes``) for consistency with\n:class:`GetOutput`, which can't use ``bytes`` because the field\nname shadows the builtin used in ``content: str | bytes``.",
  "properties": {
    "ok": {"title": "Ok", "type": "boolean"},
    "uri": {"default": "", "title": "Uri", "type": "string"},
    "key": {"default": "", "title": "Key", "type": "string"},
    "sha256": {"default": "", "title": "Sha256", "type": "string"},
    "size_bytes": {"default": 0, "title": "Size Bytes", "type": "integer"},
    "error": {"default": "", "title": "Error", "type": "string"}
  },
  "required": ["ok"],
  "title": "PutOutput",
  "type": "object"
}
