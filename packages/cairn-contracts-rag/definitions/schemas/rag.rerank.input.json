{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract://rag.rerank.input/1.0.0",
  "$defs": {
    "RerankHit": {
      "description": "One candidate to re-rank. ``text`` is scored against the query; ``score``\nis the incoming (retrieval) score; ``payload`` is carried through opaque.",
      "properties": {
        "score": {"default": 0.0, "title": "Score", "type": "number"},
        "text": {"default": "", "title": "Text", "type": "string"},
        "payload": {"additionalProperties": true, "title": "Payload", "type": "object"}
      },
      "title": "RerankHit",
      "type": "object"
    }
  },
  "properties": {
    "query": {"title": "Query", "type": "string"},
    "hits": {"items": {"$ref": "#/$defs/RerankHit"}, "title": "Hits", "type": "array"},
    "top_k": {"default": 4, "title": "Top K", "type": "integer"},
    "reranker": {"default": "auto", "title": "Reranker", "type": "string"},
    "model": {"default": "cross-encoder/ms-marco-MiniLM-L-6-v2", "title": "Model", "type": "string"}
  },
  "required": ["query"],
  "title": "RerankInput",
  "type": "object"
}
