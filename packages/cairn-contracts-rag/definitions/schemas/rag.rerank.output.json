{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract://rag.rerank.output/1.0.0",
  "$defs": {
    "RerankHit": {
      "description": "One candidate to re-rank. ``text`` is scored against the query; ``score``\nis the incoming (retrieval) score; ``payload`` is carried through opaque.",
      "properties": {
        "score": {"default": 0.0, "title": "Score", "type": "number"},
        "text": {"default": "", "title": "Text", "type": "string"},
        "payload": {"additionalProperties": true, "title": "Payload", "type": "object"}
      },
      "title": "RerankHit",
      "type": "object"
    }
  },
  "properties": {
    "ok": {"default": true, "title": "Ok", "type": "boolean"},
    "hits": {"items": {"$ref": "#/$defs/RerankHit"}, "title": "Hits", "type": "array"},
    "reranker_used": {
      "default": "identity",
      "title": "Reranker Used",
      "type": "string",
      "enum": ["identity", "cross_encoder", "cohere", "mock"]
    },
    "error": {"default": "", "title": "Error", "type": "string"}
  },
  "title": "RerankOutput",
  "type": "object"
}
