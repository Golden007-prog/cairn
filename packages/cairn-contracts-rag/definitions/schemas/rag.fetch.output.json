{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract://rag.fetch.output/1.0.0",
  "$defs": {
    "FetchedChunk": {
      "description": "One chunk of a fetched source.",
      "properties": {"payload": {"additionalProperties": true, "title": "Payload", "type": "object"}},
      "title": "FetchedChunk",
      "type": "object"
    }
  },
  "description": "Result of a RAG fetch.",
  "properties": {
    "ok": {"title": "Ok", "type": "boolean"},
    "found": {"default": false, "title": "Found", "type": "boolean"},
    "chunks": {"items": {"$ref": "#/$defs/FetchedChunk"}, "title": "Chunks", "type": "array"},
    "error": {"default": "", "title": "Error", "type": "string"}
  },
  "required": ["ok"],
  "title": "FetchOutput",
  "type": "object"
}
