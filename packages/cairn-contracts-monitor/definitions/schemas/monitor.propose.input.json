{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract://monitor.propose.input/1.0.0",
  "properties": {
    "metric": {
      "description": "The signal that crossed (e.g. 'chatbot-intents PSI').",
      "title": "Metric",
      "type": "string"
    },
    "value": {"description": "The observed value.", "title": "Value", "type": "number"},
    "threshold": {"description": "The threshold it crossed.", "title": "Threshold", "type": "number"},
    "proposed_workflow": {
      "description": "The workflow a human is being asked to approve running (e.g. 'training/finetune').",
      "title": "Proposed Workflow",
      "type": "string"
    },
    "est_cost_usd": {
      "default": 0.0,
      "description": "Rough estimated cost of the proposed run (for the approval card).",
      "title": "Est Cost Usd",
      "type": "number"
    }
  },
  "required": ["metric", "value", "threshold", "proposed_workflow"],
  "title": "ProposeInput",
  "type": "object"
}
