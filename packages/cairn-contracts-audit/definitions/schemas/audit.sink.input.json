{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract://audit.sink.input/1.0.0",
  "properties": {
    "action": {"description": "Dotted verb, e.g. 'tool.call'.", "title": "Action", "type": "string"},
    "outcome": {"default": "ok", "description": "ok | deny | error.", "title": "Outcome", "type": "string"},
    "actor": {
      "anyOf": [{"type": "string"}, {"type": "null"}],
      "default": null,
      "description": "Who triggered it (client/skill).",
      "title": "Actor"
    },
    "target": {
      "anyOf": [{"type": "string"}, {"type": "null"}],
      "default": null,
      "description": "What it acted on (model, server/tool).",
      "title": "Target"
    },
    "run_id": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "title": "Run Id"},
    "ts": {
      "default": "",
      "description": "ISO timestamp; filled by the sink if blank.",
      "title": "Ts",
      "type": "string"
    },
    "metadata": {"additionalProperties": true, "title": "Metadata", "type": "object"}
  },
  "required": ["action"],
  "title": "AuditWriteInput",
  "type": "object"
}
