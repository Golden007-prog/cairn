{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract://redact.text.output/1.0.0",
  "properties": {
    "ok": {"default": true, "title": "Ok", "type": "boolean"},
    "text": {"description": "Redacted text (placeholders substituted).", "title": "Text", "type": "string"},
    "redacted": {"description": "True if any span was redacted.", "title": "Redacted", "type": "boolean"},
    "span_count": {"default": 0, "title": "Span Count", "type": "integer"},
    "kinds": {
      "description": "Distinct recognizer kinds hit.",
      "items": {"type": "string"},
      "title": "Kinds",
      "type": "array"
    }
  },
  "required": ["text", "redacted"],
  "title": "RedactTextOutput",
  "type": "object"
}
