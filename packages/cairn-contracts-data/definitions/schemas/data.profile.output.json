{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contract://data.profile.output/1.0.0",
  "$defs": {
    "RoleReport": {
      "properties": {
        "name": {"title": "Name", "type": "string"},
        "required": {"title": "Required", "type": "boolean"},
        "resolved": {"title": "Resolved", "type": "boolean"},
        "column": {"anyOf": [{"type": "string"}, {"type": "null"}], "default": null, "title": "Column"},
        "coverage": {"default": 0.0, "title": "Coverage", "type": "number"}
      },
      "required": ["name", "required", "resolved"],
      "title": "RoleReport",
      "type": "object"
    }
  },
  "properties": {
    "ok": {"description": "False when the verdict is BLOCK.", "title": "Ok", "type": "boolean"},
    "verdict": {
      "description": "pass | degrade | block",
      "title": "Verdict",
      "type": "string",
      "enum": ["pass", "degrade", "block"]
    },
    "record_count": {"default": 0, "title": "Record Count", "type": "integer"},
    "detected_format": {"default": "unknown", "title": "Detected Format", "type": "string"},
    "missing_required": {"items": {"type": "string"}, "title": "Missing Required", "type": "array"},
    "degraded": {"items": {"type": "string"}, "title": "Degraded", "type": "array"},
    "errors": {"items": {"type": "string"}, "title": "Errors", "type": "array"},
    "note": {"default": "", "title": "Note", "type": "string"},
    "roles": {"items": {"$ref": "#/$defs/RoleReport"}, "title": "Roles", "type": "array"}
  },
  "required": ["ok", "verdict"],
  "title": "DataProfileOutput",
  "type": "object"
}
