# The image a REMOTE dataflow/ml task runs in (ADR-0089 #1346).
#
# `Dockerfile.engine` builds the CONTROL PLANE — server, console, every runtime
# extra, torch under PRODUCTION_TIER. A Metaflow `@kubernetes`/`@batch` task
# needs none of that: it runs ONE `CairnFlow.execute` step, which parses a
# DataflowSpec and drives the shared runner over the kernel registry. So this
# image carries exactly that, and is small enough to pull onto a cold node
# without dominating the job's wall clock.
#
# What a task genuinely needs:
#   * metaflow           — the task process itself is `python -m metaflow …`; the bridge it
#                          runs is cairn-operator-dataflow-metaflow's (ADR-0134 D2)
#   * cairn core         — DataflowSpec/DataflowResult (the boundary contract) and the
#                          shared `run_dataflow` runner + stage loader (cairn.core.dataflow, #2583)
#   * cairn-operator-dataflow  — the engine entrypoint (cairn-dataflow-run); the Metaflow
#                          bridge flow is cairn-operator-dataflow-metaflow's (ADR-0134 D2)
#   * the kernel packs   — whatever `spec.stages` names must be resolvable, or
#                          the flow fails at stage 0 having already paid for the
#                          node (engine.validate() catches this control-side,
#                          but only for stages the CONTROL PLANE can see)
#   * boto3              — the S3 datastore is mandatory for remote compute
#                          (#1349 refuses remote + local datastore)
#
# Deliberately absent: torch, the console SPA, temporal/dbos runtimes, the
# server. A task that needs a GPU trainer uses the training image instead —
# this one is the data/ml-kernel substrate.
FROM python:3.13-slim-trixie

ENV PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

# `uv` for resolution speed; git because a few kernel extras resolve VCS pins.
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && pip install uv

WORKDIR /app

# Source layout mirrors the workspace so the operator packs resolve as local
# path deps exactly as they do in CI — a task must run the SAME kernel code the
# control plane validated against, not a re-resolved PyPI version.
COPY pyproject.toml README.md ./
COPY cairn ./cairn
# `client`, `ask` and `sdk` are uv WORKSPACE MEMBERS (ADR-0085 D7 / ADR-0087):
# `[tool.uv.sources]` pins them `workspace = true`, so resolution of the root
# package FAILS ("references a workspace … but is not a workspace member") if
# any of the three is absent — even though a dataflow task imports none of
# them. They are small; omitting one costs a full failed build to discover.
COPY client ./client
COPY ask ./ask
COPY sdk ./sdk
# #2241 D — the contract distribution is a workspace member (`editable = false`) on the
# same rule; a task imports none of it, but resolution of the root fails without it.
COPY contracts ./contracts

# `--extra engine` is the whole point: it pulls the dataflow engine + kernel
# runtimes (polars/duckdb) the stages actually execute in. Installing the root
# package alone yields an image whose flow dies with "unknown stage".
RUN uv pip install --system --no-cache \
        -e . \
        -e ./cairn/operators/builtins/dataflow \
        -e ./cairn/operators/optional/dataflow_metaflow \
        -e ./cairn/operators/official/dataset_checks \
        metaflow boto3 \
    && uv pip install --system --no-cache polars duckdb \
    # `kubernetes` is the CLIENT the submitter uses to talk to the API server.
    # Its absence does not error — Metaflow simply never schedules and the
    # submit hangs (observed: 10 minutes, no pod). Present here because this
    # image doubles as the submitting environment in the ADR-0089 acceptance.
    && uv pip install --system --no-cache kubernetes

# Fail the BUILD, not the first remote task, if the registry cannot resolve the
# kernels this image exists to run.
RUN python -c "\
from operator_dataflow.stages import load_stages; \
s = load_stages(); \
assert 'ingest.normalize' in s and 'dedup.exact' in s, sorted(s); \
import metaflow, boto3; \
import operator_dataflow_metaflow.metaflow_bridge, operator_dataflow_metaflow.metaflow_train_bridge; \
print('task image OK — kernels:', len(s))"

CMD ["python", "-c", "print('cairn dataflow task image')"]
